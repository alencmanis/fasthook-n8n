{
	"name": "n8n-nodes-fasthook",
	"version": "0.1.0",
	"description": "FastHook requests, delivery history, replay and new request polling for n8n",
	"license": "MIT",
	"private": true,
	"homepage": "https://www.fasthook.io",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alencmanis/fasthook-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/alencmanis/fasthook-n8n/issues"
	},
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Andrew",
		"email": "andrew.lencmanis@veset.tv"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/*.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"examples",
		"CHANGELOG.md",
		"RELEASE.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FastHookApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FastHook/FastHook.node.js",
			"dist/nodes/FastHook/FastHookTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"n8n-workflow": "2.16.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
